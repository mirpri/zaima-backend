# ============================================================
# 部署环境变量示例。使用方法:
#   cp .env.example .env  然后按需修改；docker compose 会自动读取。
# 这些 ZAIMA_* 变量会覆盖 configs/config.docker.yaml 中的同名配置。
# ============================================================

# 运行模式: 生产填 release (debug 下短信验证码会直接返回, 勿用于生产)
ZAIMA_SERVER_MODE=release

# JWT 签名密钥: 换成一串足够长的随机字符串
ZAIMA_JWT_SECRET=please-change-to-a-long-random-secret

# 数据库密码: postgres 容器与后端共用此变量, 保持一致即可
POSTGRES_PASSWORD=please-change-to-a-strong-password

# DeepSeek / OpenAI 兼容大模型 Key (留空则 AI 功能回退规则引擎)
ZAIMA_LLM_API_KEY=

# 自建文件存储对外访问域名 (https)。留空则上传接口返回相对路径。
# 例: https://api.your-domain.com
ZAIMA_STORAGE_PUBLIC_BASE_URL=
